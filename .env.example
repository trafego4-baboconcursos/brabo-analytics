# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Direct Connection (use essa, não a pooler, para ETL com SQLAlchemy)
# Supabase > Settings > Database > Connection string > URI
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_USERS_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Autenticação do dashboard
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=mude-esta-chave-em-producao
# Timeout de sessão em segundos (padrão: 604800 = 7 dias)
SESSION_MAX_AGE=604800
# Marcar cookie como Secure (apenas HTTPS). Manter false em desenvolvimento local.
COOKIE_SECURE=false
# Expor /docs e /redoc (Swagger UI). Manter false em produção.
SHOW_API_DOCS=false
# Ativar HSTS após confirmar que HTTPS funciona (0 = desativado)
HSTS_MAX_AGE=0
# Credenciais legado (fallback quando DB está indisponível)
BRABO_USER=admin@seudominio.com
BRABO_PASS=troque-por-senha-forte-20-chars

# Webhook para alertas de falha no ETL (Discord/Slack)
ERROR_WEBHOOK_URL=

# Slack (Bot Token) para o relatório diário de orçamento (planejado x real), 9h
# api.slack.com/apps > seu app > OAuth & Permissions > Bot User OAuth Token (xoxb-...)
# O bot precisa estar adicionado/convidado no canal de destino.
SLACK_BOT_TOKEN=
SLACK_BUDGET_CHANNEL=#trafego-360

# Pré-aquecer o cache dos lançamentos ativos no startup do dashboard (padrão: true)
PRE_WARM_CACHE=true
# Re-aquecer sozinho (cache + snapshot do debriefing) a cada N minutos,
# mesmo sem o aviso do ETL abaixo. 0 desativa. Padrão: 30.
PRE_WARM_INTERVAL_MIN=30

# Re-aquecer o cache do dashboard ao fim de cada rodada do ETL. O scheduler
# faz POST em FRONTEND_URL/api/etl/refresh com o header X-ETL-Token; o
# dashboard só aceita se o token bater. Sem ETL_REFRESH_TOKEN, o aviso é
# pulado e o cache expira sozinho (1h). Use um valor longo e aleatório, o
# mesmo nos dois processos (dashboard e scheduler).
FRONTEND_URL=http://127.0.0.1:8000
ETL_REFRESH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Active Campaign
# Account Settings > Developer > API Access
# ─────────────────────────────────────────────────────────────────────────────
AC_API_URL=https://[SUA-CONTA].api-us1.com/api/3
AC_API_KEY=

# IDs dos campos customizados de UTM.
# Para descobrir os IDs: python etl/etl_active_campaign.py --discover-fields
AC_FIELD_UTM_CAMPAIGN=
AC_FIELD_UTM_SOURCE=
AC_FIELD_UTM_MEDIUM=
AC_FIELD_UTM_CONTENT=
AC_FIELD_UTM_TERM=

# ─────────────────────────────────────────────────────────────────────────────
# Meta Ads (Marketing API)
# developers.facebook.com > Tools > Graph API Explorer > Get Token
# Permissões necessárias: ads_read, read_insights
# ─────────────────────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=
# Meta Ads Manager > Settings > Account ID  (formato: act_XXXXXXXXX)
META_AD_ACCOUNT_ID=act_XXXXXXXXX

# Instagram (perfil dos experts — Mateus Andrade, Brabo Concursos, Felipe Graton)
# Os IDs das contas Instagram (Business, vinculadas às nossas Páginas) estão
# fixos em frontend/services/instagram.py. Só precisa que META_ACCESS_TOKEN
# tenha também o escopo instagram_basic (Meta App Dashboard > Casos de uso >
# "Gerenciar mensagens e conteúdo no Instagram").

# ─────────────────────────────────────────────────────────────────────────────
# Google Ads (REST API)
# console.cloud.google.com > Credenciais > OAuth 2.0 (tipo Desktop)
# Para gerar o refresh token: python etl/etl_google_ads.py --get-token
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# YouTube Analytics (mesmo CLIENT_ID/SECRET do Google Ads, escopos diferentes)
# Para gerar: python etl/get_youtube_token.py
YOUTUBE_REFRESH_TOKEN=
# ID do cliente sem hífens (ex: 1234567890)
GOOGLE_ADS_CUSTOMER_ID=
# Se usar MCC: ID da conta gerenciadora. Caso contrário, deixe igual ao CUSTOMER_ID
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Service account do Google Drive (thumbnails de criativos) — em produção/Docker,
# cole aqui o CONTEÚDO do arquivo json/uplifted-kit-*.json (uma linha só).
# Localmente pode deixar vazio: o app usa o arquivo da pasta json/.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────────────────────────────────────────────────────
# SendFlow — NÃO usado mais pelo app (mantido só porque frontend/db_readers/
# sendflow_contagem.py ainda existe no repo, sem uso). A contagem de grupos de
# WhatsApp (Total/Total Limpo/Grupos Cheios/Entrada/Saída) agora vem só do
# Sheets, ver seção abaixo.
SENDFLOW_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Contagem de grupos WhatsApp — via Google Sheets (leitura), etl/etl_sheets_contagem.py
# Conteúdo do JSON da service account que o sendflow-analytics-poller já usa
# pra ESCREVER nessas planilhas (aqui só lemos) — mesma credencial, sem
# precisar compartilhar de novo. Cole o conteúdo do JSON numa linha só.
# Mapeamento lançamento -> planilha em config/sheets_contagem.yaml.
GOOGLE_SHEETS_CONTAGEM_JSON=

# ─────────────────────────────────────────────────────────────────────────────
# Typeform
# app.typeform.com > Conta > Settings > Personal Tokens
# ─────────────────────────────────────────────────────────────────────────────
TYPEFORM_TOKEN=
# ID do formulário: encontre na URL  app.typeform.com/to/[FORM_ID]
TYPEFORM_FORM_ID=

# GA4 (Google Analytics Data API - reaproveita o OAuth client do Google Ads)
GA4_REFRESH_TOKEN=
GA4_PROPERTY_IDS=
