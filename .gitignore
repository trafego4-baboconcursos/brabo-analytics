# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Ambiente virtual
.venv/
venv/
env/

# Credenciais e segredos
.env
*.env
json/
youtube/client_secrets.json
youtube/token_bb.json
client_secret*.json
token*.json
checklist/

# Logs gerados em runtime
logs/
*.log

# Cache
.uv-cache/
.cache/

# IDE
.vscode/
.idea/
*.code-workspace

# Dados locais / exports temporários
*.csv.tmp

# pytest
.pytest_cache/
.coverage
htmlcov/

# pre-commit
.pre-commit-cache/

# Node
node_modules/

# Dados de lançamentos (CSVs/planilhas grandes, contêm PII de leads/compradores)
analises/**/*.csv
analises/**/*.xlsx
# Exceção: dados de referência do calendário (sem PII, servidos pela página do calendário)
!analises/calendario/BASE_CONSULTA_CALENDARIO_2026.csv
!analises/calendario/BASE_CONSULTA_CALENDARIO_2026_EXTRAIDA.csv
active-campaign/

# Exports/planilhas de trabalho soltos na raiz (mesma razão do analises/**/*.csv acima —
# dado bruto de campanha, não pertence ao repo)
planilhas/

# Temporários
temp/
.tmp/

# Claude Code (configurações locais)
.claude/settings.local.json
claude-memory-export/

# Logs rotacionados (etl/scheduler.log.1, etc.)
*.log.[0-9]*

# Credenciais renomeadas/removidas manualmente (não pega no client_secret*.json)
*.old_deleted

# Artefatos de automação de browser (screenshots/snapshots podem conter dados reais da tela)
.playwright-mcp/

# Performance Manager: SÓ criativos (mp4/psd/jpg, ~8 GB) e CSVs com PII — local, nunca versionar.
# Os .md de ad-ops moraram aqui até 14/09/26; agora ficam em documentacao/performance/ (versionados).
performance-manager/

# Customer Match: e-mail/telefone de leads (PII) — nunca versionar, esteja onde estiver
customer_match_*.csv

# Obsidian: estado de janela/layout do vault (o resto da config do vault é versionado)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# Estado do alerta de orçamento (runtime, não versionar)
etl/budget_alert_state.json

# Documentacao: so docs/sistema/ vai pro git (pedido do usuario 14/09/26).
# O resto do vault (negocio, operacao, performance, projetos, analises, historico)
# fica so na maquina do usuario.
docs/*
!docs/sistema/
!docs/.gitkeep
