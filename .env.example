# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Direct Connection (use essa, não a pooler, para ETL com SQLAlchemy)
# Supabase > Settings > Database > Connection string > URI
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_USERS_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Autenticação do dashboard
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=mude-esta-chave-em-producao
# Timeout de sessão em segundos (padrão: 604800 = 7 dias)
SESSION_MAX_AGE=604800
# Marcar cookie como Secure (apenas HTTPS). Manter false em desenvolvimento local.
COOKIE_SECURE=false
# Expor /docs e /redoc (Swagger UI). Manter false em produção.
SHOW_API_DOCS=false
# Ativar HSTS após confirmar que HTTPS funciona (0 = desativado)
HSTS_MAX_AGE=0
# Credenciais legado (fallback quando DB está indisponível)
BRABO_USER=admin@seudominio.com
BRABO_PASS=troque-por-senha-forte-20-chars

# Webhook para alertas de falha no ETL (Discord/Slack)
ERROR_WEBHOOK_URL=

# Pré-aquecer o cache dos lançamentos ativos no startup do dashboard (padrão: true)
PRE_WARM_CACHE=true

# ─────────────────────────────────────────────────────────────────────────────
# Active Campaign
# Account Settings > Developer > API Access
# ─────────────────────────────────────────────────────────────────────────────
AC_API_URL=https://[SUA-CONTA].api-us1.com/api/3
AC_API_KEY=

# IDs dos campos customizados de UTM.
# Para descobrir os IDs: python etl/etl_active_campaign.py --discover-fields
AC_FIELD_UTM_CAMPAIGN=
AC_FIELD_UTM_SOURCE=
AC_FIELD_UTM_MEDIUM=
AC_FIELD_UTM_CONTENT=
AC_FIELD_UTM_TERM=

# ─────────────────────────────────────────────────────────────────────────────
# Meta Ads (Marketing API)
# developers.facebook.com > Tools > Graph API Explorer > Get Token
# Permissões necessárias: ads_read, read_insights
# ─────────────────────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=
# Meta Ads Manager > Settings > Account ID  (formato: act_XXXXXXXXX)
META_AD_ACCOUNT_ID=act_XXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# Google Ads (REST API)
# console.cloud.google.com > Credenciais > OAuth 2.0 (tipo Desktop)
# Para gerar o refresh token: python etl/etl_google_ads.py --get-token
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# YouTube Analytics (mesmo CLIENT_ID/SECRET do Google Ads, escopos diferentes)
# Para gerar: python etl/get_youtube_token.py
YOUTUBE_REFRESH_TOKEN=
# ID do cliente sem hífens (ex: 1234567890)
GOOGLE_ADS_CUSTOMER_ID=
# Se usar MCC: ID da conta gerenciadora. Caso contrário, deixe igual ao CUSTOMER_ID
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Typeform
# app.typeform.com > Conta > Settings > Personal Tokens
# ─────────────────────────────────────────────────────────────────────────────
TYPEFORM_TOKEN=
# ID do formulário: encontre na URL  app.typeform.com/to/[FORM_ID]
TYPEFORM_FORM_ID=
